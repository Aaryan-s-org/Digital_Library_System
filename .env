# ======================================
# Digital Library Portal - Environment
# ======================================

# Server
PORT=5000
NODE_ENV=development

# Database (3307 is mapped to docker MySQL container)
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=digital_library_portal

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Seeding
SEED_ON_START=true

# Razorpay Payment Gateway (Test Mode)
# Enter your Razorpay test API key pair here:
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
