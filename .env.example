# ======================================
# Digital Library Portal - Environment
# ======================================

# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=db
DB_USER=root
DB_PASSWORD=root
DB_NAME=digital_library_portal

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Seeding (set to 'true' on first run to populate ebooks)
SEED_ON_START=true
